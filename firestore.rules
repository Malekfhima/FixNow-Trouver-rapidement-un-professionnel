rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ━━━ Helpers partagés ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    function isAuth() {
      return request.auth != null;
    }

    // Profil complet de l'appelant (1 lecture mise en cache par évaluation).
    function caller() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return caller().role;
    }

    function isClient() {
      // Tout compte authentifié peut réserver (pro inclus).
      return isAuth();
    }

    function isPro() {
      return isAuth() && (role() == 'pro' || caller().get('isPro', false) == true);
    }

    // ── Rôles : migration vers les custom claims ──────────────────────
    // CIBLE : isAdmin() = isAuth() && request.auth.token.get('admin', false) == true
    //         → plus aucune lecture de users/ à chaque évaluation de règle.
    // EN COURS : le rôle legacy (users/{uid}.role == 'admin') reste accepté
    //            pour ne casser aucun compte existant.
    // PROCÉDURE : voir tool/set_custom_claims.js et CHANGELOG.md.
    // 1) node tool/set_custom_claims.js <uid...>  (pose le claim admin)
    // 2) une fois TOUS les admins migrés, remplacer le corps de isAdmin()
    //    par la forme « cible » ci-dessus et redéployer.
    function isAdmin() {
      return isAuth() && (
        request.auth.token.get('admin', false) == true || role() == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ━━━ users/{uid} — PROFIL PRIVÉ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    // email / phone / fcmToken ne sont plus lisibles par tout le monde :
    // les affichages publics (chat, avis, notifications) lisent
    // publicProfiles/{uid} ci-dessous.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId);

      // Le propriétaire met à jour son profil — jamais son propre rôle
      // admin. L'auto-promotion pro (role + isPro ensemble) reste autorisée.
      allow update: if isAdmin()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPro'])
        )
        || (isOwner(userId)
          && request.resource.data.role == 'pro'
          && request.resource.data.isPro == true
          && resource.data.role != 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isPro'])
        );

      allow delete: if isAdmin();
    }

    // ━━━ publicProfiles/{uid} — IDENTITÉ PUBLIQUE ━━━━━━━━━━━━━━━━━━━━━
    // Lisible par tout utilisateur connecté : nom, avatar, rôle affiché.
    // Ne contient JAMAIS email / phone / fcmToken.
    // NB : ce rôle est purement indicatif (affichage) — toute décision
    // d'autorisation lit users/{uid}.role ou le custom claim.
    match /publicProfiles/{uid} {
      allow read: if isAuth();

      allow create: if isOwner(uid)
        && validPublicProfile(request.resource.data);

      allow update: if (isOwner(uid) || isAdmin())
        && validPublicProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'avatarUrl', 'role']);

      allow delete: if isOwner(uid) || isAdmin();

      function validPublicProfile(data) {
        return data.name is string
          && data.name.size() <= 120
          && (data.get('avatarUrl', null) == null || data.get('avatarUrl', '') is string)
          && data.get('role', '') in ['client', 'pro', 'admin'];
      }
    }

    // ━━━ professionals/{proId} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    match /professionals/{proId} {
      // Lecture : profils approuvés, son propre profil, ou admin.
      allow read: if isAuth() && (
        resource.data.status == 'approved' || isOwner(proId) || isAdmin()
      );

      // 1) CRÉATION : un pro ouvre toujours son profil en 'pending' avec
      //    des notes à zéro → il ne peut JAMAIS s'auto-approuver.
      //    L'admin conserve la création de ses démos (ids demo-*).
      allow create: if (
          isOwner(proId) && isPro()
          && request.resource.data.status == 'pending'
          && request.resource.data.get('ratingAvg', 0) == 0
          && request.resource.data.get('ratingCount', 0) == 0
          && request.resource.data.get('lastRatingReviewId', '') == ''
        ) || (isAdmin() && proId.matches('demo-.*'));

      // 2) Le pro modifie son profil — jamais son statut ni ses notes.
      allow update: if isOwner(proId) && isPro()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['status', 'ratingAvg', 'ratingCount', 'lastRatingReviewId']
        );

      // 3) COMpteurs de notes (sans Cloud Functions) :
      //    autorisés UNIQUEMENT dans le même batch/transaction que la
      //    création de l'avis qui les justifie, prouvée via getAfter().
      //    Le client doit envoyer lastRatingReviewId = id de l'avis
      //    (= requestId) ; la cohérence est vérifiée exactement :
      //    ratingCount + 1 et ratingAvg = moyenne induite par le nouveau
      //    avis (entier 1..5), donc bornée 1..5.
      allow update: if isAuth() && !isOwner(proId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ratingAvg', 'ratingCount', 'lastRatingReviewId'])
        && ratingUpdateIsCoherent();

      // 4) L'admin approuve / rejette / corrige (modération).
      allow update: if isAdmin();

      allow delete: if isAdmin();

      // ── Cohérence de la mise à jour des notes ──────────────────────
      // get()     = état AVANT le batch (l'avis n'existe pas encore)
      // getAfter()= état APRÈS le batch (l'avis existe)
      // → impossible d'incrémenter les compteurs sans créer l'avis
      //   qui va avec, et impossible de recompter deux fois le même avis.
      function reviewAfter() {
        return getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastRatingReviewId)).data;
      }

      function reviewDoesNotExistYet() {
        return !exists(/databases/$(database)/documents/reviews/$(request.resource.data.lastRatingReviewId));
      }

      // Nouvelle moyenne implicite : avg' * count' - avg * count = note de l'avis.
      function impliedRating() {
        return request.resource.data.ratingAvg * request.resource.data.ratingCount
          - resource.data.get('ratingAvg', 0) * resource.data.get('ratingCount', 0);
      }

      function ratingUpdateIsCoherent() {
        return request.resource.data.lastRatingReviewId is string
          && request.resource.data.lastRatingReviewId != resource.data.get('lastRatingReviewId', '')
          && reviewDoesNotExistYet()
          // L'avis doit exister APRÈS le batch, être signé par l'appelant
          // et cibler ce professionnel.
          && reviewAfter().requestId == request.resource.data.lastRatingReviewId
          && reviewAfter().clientId == request.auth.uid
          && reviewAfter().proId == proId
          && reviewAfter().rating is int
          && reviewAfter().rating >= 1
          && reviewAfter().rating <= 5
          // Compteur : +1 exactement.
          && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
          // Moyenne recalculée : bornée 1..5 et égale à la note portée
          // par l'avis (tolérance d'arrondi 1e-4).
          && request.resource.data.ratingAvg >= 1
          && request.resource.data.ratingAvg <= 5
          && impliedRating() - reviewAfter().rating <= 0.0001
          && impliedRating() - reviewAfter().rating >= -0.0001;
      }
    }

    // ━━━ serviceRequests/{requestId} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    match /serviceRequests/{requestId} {
      // Lecture : le client émetteur, le pro ciblé, l'admin.
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.proId == request.auth.uid ||
        isAdmin()
      );

      // 1) CRÉATION (client uniquement) :
      //    - statut 'pending' (aucune approbation anticipée)
      //    - on ne peut pas se cibler soi-même
      //    - aucun champ de devis / prix déjà renseigné
      //    - la cible existe ET est approuvée par l'admin
      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.proId is string
        && request.resource.data.proId != ''
        && request.resource.data.proId != request.auth.uid
        && request.resource.data.get('quotePrice', null) == null
        && request.resource.data.get('quoteNote', null) == null
        && request.resource.data.get('price', null) == null
        && get(/databases/$(database)/documents/professionals/$(request.resource.data.proId)).data.status == 'approved';

      // ── Machine à états (miroir exact de
      //    lib/models/service_request_state_machine.dart) ─────────────
      //   pending    -> accepted (pro) | declined (pro) | quoted (pro) | cancelled (client)
      //   accepted   -> inProgress (pro) | cancelled (client)
      //   quoted     -> accepted (client, acceptation du devis) | cancelled (client)
      //   inProgress -> completed (pro)
      //   completed / declined / cancelled : terminaux.
      // Les clés immuables sont verrouillées pour TOUS les acteurs, et
      // chaque acteur n'a le droit de modifier QUE ses propres champs,
      // y compris lors d'un changement de statut.
      function touchedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function immutableUnchanged() {
        return !touchedKeys().hasAny(['clientId', 'proId', 'categoryId', 'createdAt']);
      }

      function fromStatus() { return resource.data.status; }
      function toStatus() { return request.resource.data.status; }
      function statusUnchanged() { return toStatus() == fromStatus(); }

      // Le client ne modifie que : status, description, photos, address,
      // scheduledDate (+ updatedAt, horodatage technique).
      function clientKeysOk() {
        return touchedKeys().hasOnly(
          ['status', 'description', 'photos', 'address', 'scheduledDate', 'updatedAt']
        );
      }

      // Le pro ne modifie que : status, quotePrice, quoteNote, price.
      function proKeysOk() {
        return touchedKeys().hasOnly(['status', 'quotePrice', 'quoteNote', 'price', 'updatedAt']);
      }

      function clientTransitionOk() {
        return statusUnchanged()
          || (fromStatus() == 'pending'    && toStatus() == 'cancelled')
          || (fromStatus() == 'accepted'   && toStatus() == 'cancelled')
          || (fromStatus() == 'quoted'     && toStatus() == 'cancelled')
          || (fromStatus() == 'quoted'     && toStatus() == 'accepted');
      }

      function proTransitionOk() {
        return statusUnchanged()
          || (fromStatus() == 'pending'    && (toStatus() == 'accepted'
                                            || toStatus() == 'declined'
                                            || toStatus() == 'quoted'))
          || (fromStatus() == 'accepted'   && toStatus() == 'inProgress')
          || (fromStatus() == 'inProgress' && toStatus() == 'completed');
      }

      // 2) MISE À JOUR : clés immuables + clés par acteur + machine à états.
      //    L'admin n'est PAS exempté (il n'a aucun droit d'écriture ici).
      allow update: if immutableUnchanged()
        && (
          (resource.data.clientId == request.auth.uid
            && clientKeysOk()
            && clientTransitionOk())
          || (resource.data.proId == request.auth.uid
            && proKeysOk()
            && proTransitionOk())
        );

      allow delete: if isAdmin();
    }

    // ━━━ chats + messages ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    match /chats/{chatId} {
      // Seuls les participants lisent / suppriment la conversation.
      allow read, delete: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.proId == request.auth.uid
      );

      // Création : le créateur doit être l'un des deux participants.
      allow create: if isAuth() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.proId == request.auth.uid
      );

      // Mise à jour (lastMessage, compteurs non lus…) :
      // clientId / proId sont IMMUABLES.
      allow update: if isAuth()
        && (resource.data.clientId == request.auth.uid
            || resource.data.proId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['clientId', 'proId']);

      match /messages/{messageId} {
        function inChat() {
          return isAuth() && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/chats/$(chatId)).data.proId == request.auth.uid
          );
        }

        // Lecture : réservée aux participants.
        allow read: if inChat();

        // Écriture : participant, envoyé SOUS son propre identifiant,
        // texte présent, string et <= 2000 caractères.
        allow create: if inChat()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.get('imageUrl', null) == null
              || request.resource.data.get('imageUrl', '') is string);

        // Mise à jour : uniquement l'indicateur 'read' ( accusé de lecture ).
        allow update: if inChat()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // ━━━ reviews/{reviewId} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    match /reviews/{reviewId} {
      allow read: if isAuth();

      // Un avis par demande terminée :
      // - auteur = client de la demande, doc id = requestId (unicité)
      // - demande 'completed'
      // - review.proId = pro réellement assigné à la demande
      // - rating ENTIER 1..5, commentaire string <= 1000 caractères
      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && reviewId == request.resource.data.requestId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.requestId)).data.status == 'completed'
        && get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.requestId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.requestId)).data.proId == request.resource.data.proId;

      // Les avis sont immuables.
      allow update, delete: if false;
    }

    // ━━━ notifications (événements client-side, sans Cloud Functions) ━
    // MIGRATION FUTURE (documentée) : basculer la création vers des
    // Cloud Functions (plan Blaze) — le client ne serait plus capable
    // d'inventer un événement, et le lien actor↔destinataire serait
    // vérifié côté serveur sans get() coûteux.
    match /notifications/{notificationId} {
      allow read, delete: if isAuth()
        && resource.data.userId == request.auth.uid;

      // Seul le destinataire coche « lu » (et rien d'autre).
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // 1) acteur = appelant, destinataire = chaîne
      // 2) type dans la liste blanche, textes bornés
      // 3) lien RÉEL actor↔destinataire prouvé par get() :
      //    - un chat dont les deux participants sont actor et destinataire
      //    - OU une serviceRequest partagée entre eux
      //    - OU la validation d'un pro (proApproved/proRejected) par un admin
      allow create: if isAuth()
        && request.resource.data.userId is string
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.type in [
          'newMessage', 'quoteReceived', 'requestAccepted', 'requestDeclined',
          'requestCompleted', 'requestCancelled', 'proApproved', 'proRejected',
          'generic'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && notifLinkOk();

      function chatDoc() {
        return get(/databases/$(database)/documents/chats/$(request.resource.data.relatedId)).data;
      }

      function requestDoc() {
        return get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.relatedId)).data;
      }

      function chatLink() {
        return exists(/databases/$(database)/documents/chats/$(request.resource.data.relatedId))
          && ((chatDoc().clientId == request.auth.uid && chatDoc().proId == request.resource.data.userId)
           || (chatDoc().clientId == request.resource.data.userId && chatDoc().proId == request.auth.uid));
      }

      function requestLink() {
        return exists(/databases/$(database)/documents/serviceRequests/$(request.resource.data.relatedId))
          && ((requestDoc().clientId == request.auth.uid && requestDoc().proId == request.resource.data.userId)
           || (requestDoc().clientId == request.resource.data.userId && requestDoc().proId == request.auth.uid));
      }

      function proApprovalLink() {
        return request.resource.data.type in ['proApproved', 'proRejected']
          && request.resource.data.relatedId == request.resource.data.userId
          && exists(/databases/$(database)/documents/professionals/$(request.resource.data.relatedId))
          && isAdmin();
      }

      function notifLinkOk() {
        return request.resource.data.relatedId is string
          && (chatLink() || requestLink() || proApprovalLink());
      }
    }

    // ━━━ categories (admin) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    match /categories/{categoryId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ━━━ reports (modération) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    match /reports/{reportId} {
      allow read: if isAuth() && (
        resource.data.reporterId == request.auth.uid || isAdmin()
      );

      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';

      allow update: if isAdmin()
        && request.resource.data.status in ['resolved', 'dismissed'];

      allow delete: if isAdmin();
    }
  }
}
