rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // Cached user document of the caller (1 read per evaluation).
    function caller() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return caller().role;
    }

    function isClient() {
      // Everyone can act as a client (book services), pros included.
      return isAuth();
    }

    function isPro() {
      // Pro capabilities via flag; legacy accounts may still use role == 'pro'.
      // role() is tested first because legacy docs may lack the isPro field.
      return isAuth() && (role() == 'pro' || caller().isPro == true);
    }

    function isAdmin() {
      return isAuth() && role() == 'admin';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Users collection ──────────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can read a user profile (needed for chat, reviews)
      allow read: if isAuth();

      // Users can create their own profile
      allow create: if isOwner(userId);

      // Users can update their own profile — but never their own admin role.
      // Self-upgrade to pro (isPro + role == 'pro') is allowed; role and isPro
      // must move together and never grant admin.
      allow update: if isAdmin()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPro'])
        )
        || (isOwner(userId)
          && request.resource.data.role == 'pro'
          && request.resource.data.isPro == true
          && resource.data.role != 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isPro'])
        );

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ── Professionals collection ──────────────────────────────────────
    match /professionals/{proId} {
      // Anyone authenticated can read approved professionals
      // Pros can read their own profile regardless of status
      allow read: if isAuth() && (
        resource.data.status == 'approved' ||
        isOwner(proId) ||
        isAdmin()
      );

      // Pros can create their own professional profile (first save after
      // upgrading); admins can create demo/seed profiles (ids 'demo-*')
      allow create: if (isOwner(proId) && isPro())
        || (isAdmin() && proId.matches('demo-.*'));

      // Pros can update their own profile (except status — admin validation only)
      allow update: if isOwner(proId) && isPro() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'ratingAvg', 'ratingCount']);

      // Rating aggregation after a review (no Cloud Functions yet):
      // any authenticated user may write ONLY ratingAvg/ratingCount.
      // NOTE: a backend function should take this over in production.
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAvg', 'ratingCount']);

      // Only admins can change professional status (approve/reject)
      allow update: if isAdmin();

      // Only admins can delete professional profiles
      allow delete: if isAdmin();
    }

    // ── Service Requests ──────────────────────────────────────────────
    match /serviceRequests/{requestId} {
      // Client can read their own requests
      // Pro can read requests assigned to them
      // Admin can read all
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.proId == request.auth.uid ||
        isAdmin()
      );

      // Client can create a new request
      allow create: if isClient() &&
        request.resource.data.clientId == request.auth.uid;

      // Client can update their own request (cancel, or accept a quote)
      // Pro can update requests assigned to them (accept, decline, start, complete)
      // Admin can update any request
      allow update: if isAuth() && (
        (resource.data.clientId == request.auth.uid &&
         request.resource.data.status == 'cancelled') ||
        (resource.data.clientId == request.auth.uid &&
         request.resource.data.status == 'accepted' &&
         resource.data.status == 'quoted') ||
        (resource.data.proId == request.auth.uid) ||
        isAdmin()
      );

      // Only admins can delete requests
      allow delete: if isAdmin();
    }

    // ── Chats ─────────────────────────────────────────────────────────
    match /chats/{chatId} {
      // Only chat participants can read/update/delete a conversation
      allow read, update, delete: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.proId == request.auth.uid
      );

      // Only participants can create a conversation, with themselves on one side
      allow create: if isAuth() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.proId == request.auth.uid
      );

      match /messages/{messageId} {
        // Only chat participants can read messages
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.proId == request.auth.uid
        );

        // Only chat participants can send messages, and only as themselves
        allow create: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.proId == request.auth.uid
        ) && request.resource.data.senderId == request.auth.uid;

        // Participants can update read status
        allow update: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.proId == request.auth.uid
        );
      }
    }

    // ── Reviews ───────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Anyone authenticated can read reviews
      allow read: if isAuth();

      // One review per completed service request:
      // - caller must be the client of the request
      // - the request must be completed
      // - no existing review for that request (uniqueness via unique requestId doc id)
      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.requestId)).data.status == 'completed'
        && get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.requestId)).data.clientId == request.auth.uid
        && reviewId == request.resource.data.requestId;

      // No updates or deletions allowed for reviews (immutable)
      allow update, delete: if false;
    }

    // ── Notifications (in-app, client-side events) ───────────────────
    match /notifications/{notificationId} {
      // Only the recipient can read / mark-as-read / delete.
      allow read, update, delete: if isAuth()
        && resource.data.userId == request.auth.uid;

      // Any authenticated user can create a notification for someone else
      // (new message, quote received…). Without Cloud Functions this is
      // client-side, so we bind every notification to its real actor.
      allow create: if isAuth()
        && request.resource.data.userId is string
        && request.resource.data.actorId == request.auth.uid;
    }

    // ── Categories (admin only) ───────────────────────────────────────
    match /categories/{categoryId} {
      // Anyone authenticated can read categories
      allow read: if isAuth();

      // Only admins can manage categories
      allow write: if isAdmin();
    }

    // ── Reports ───────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Reporter can read their own report, admins can read all
      allow read: if isAuth() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );

      // Any authenticated user can create a report
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;

      // Only admins can update reports (investigate, resolve)
      allow update: if isAdmin();

      // Only admins can delete reports
      allow delete: if isAdmin();
    }
  }
}
