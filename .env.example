# Modèle de configuration — copier ce fichier en `.env` puis remplir les valeurs.
#   cp .env.example .env
# L'application se lance avec :
#   flutter run --dart-define-from-file=.env
#
# ⚠️ `.env` est ignoré par Git : ne JAMAIS le committer.

# ── Cloudinary (upload d'images, mode unsigned) ────────────────────
# Dashboard Cloudinary : paramètres du cloud + Settings → Upload → preset
# "Unsigned", images uniquement, max 5 Mo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ── Firebase (client) ──────────────────────────────────────────────
# Identifiants générés par `flutterfire configure` (Console Firebase →
# Paramètres du projet → Général → Vos applications).
# Valeurs vides = app lancée sans backend (comportement prévu).

# Web
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MEASUREMENT_ID=

# Windows (appId / measurementId distincts du web, mêmes clés)
FIREBASE_WINDOWS_APP_ID=
FIREBASE_WINDOWS_MEASUREMENT_ID=

# Android
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# iOS / macOS (dossier ios, bundle identifier)
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=

# Communs à toutes les plateformes
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
